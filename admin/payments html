<div class="bg-white border rounded p-5">

    <h2 class="text-xl font-bold mb-5">
        Expense Payment Entry
    </h2>

    <div class="grid grid-cols-3 gap-4">

        <input
            id="paymentVendor"
            class="border p-2 rounded"
            placeholder="Vendor / Employee Name">

        <select
            id="paymentHead"
            class="border p-2 rounded">

            <option>Salary</option>
            <option>Rent</option>
            <option>Electricity</option>
            <option>Medicine Purchase</option>
            <option>Marketing</option>
            <option>Maintenance</option>
            <option>Other</option>

        </select>

        <input
            id="paymentAmount"
            class="border p-2 rounded"
            placeholder="Amount">

        <select
            id="paymentMode"
            class="border p-2 rounded">

            <option>Cash</option>
            <option>UPI</option>
            <option>Bank</option>
            <option>Card</option>

        </select>

        <select
            id="paymentBranch"
            class="border p-2 rounded">

            <option value="">
                Select Branch
            </option>

        </select>

        <input
            type="date"
            id="paymentDate"
            class="border p-2 rounded">

    </div>

    <textarea
        id="paymentRemarks"
        class="border p-2 rounded w-full mt-4"
        placeholder="Remarks">
    </textarea>

    <button
        onclick="savePayment()"
        class="bg-red-700 text-white px-4 py-2 rounded mt-4">

        Save Payment

    </button>

</div>

<div class="bg-white border rounded p-5 mt-5">

    <table class="w-full">

        <thead>

        <tr>

            <th>Payment No</th>
            <th>Date</th>
            <th>Vendor</th>
            <th>Expense Head</th>
            <th>Mode</th>
            <th>Amount</th>

        </tr>

        </thead>

        <tbody id="paymentTable">

        </tbody>

    </table>

</div>