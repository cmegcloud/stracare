<p>Please enter the exact details of the patient receiving treatment.</p>
</div>
<form id="appointmentForm">
<div class="form-section-title">Personal Information</div>
<div class="form-group">
<label>Contact Phone Number <span style="color:red">*</span></label>
<div style="display: flex; gap: 8px;">
<input class="form-control" id="pat_mobile" maxlength="10" pattern="[0-9]{10}" placeholder="10-digit number" required="" type="tel"/>
<button class="btn-verify" id="verifyBtn" type="button">Check</button>
</div>
</div>
<div class="form-group">
<label>Patient Full Legal Name <span style="color:red">*</span></label>
<input class="form-control" id="pat_name" placeholder="e.g., John Doe" required="" type="text"/>
</div>
<div class="form-row">
<div class="form-group">
<label>Age <span style="color:red">*</span></label>
<input class="form-control" id="pat_age" max="120" min="1" placeholder="Years" required="" type="number"/>
</div>
<div class="form-group">
<label>Gender <span style="color:red">*</span></label>
<select class="form-control" id="pat_gender" required="">
<option disabled="" selected="" value="">Select</option>
<option value="Male">Male</option>
<option value="Female">Female</option>
<option value="Other">Other</option>
</select>
</div>
</div>
<div class="form-section-title">Location Details</div>
<div class="form-group">
<label>Patient Address / Location <span style="color:red">*</span></label>
<textarea class="form-control" id="pat_address" placeholder="Enter full address, landmark, or click below to auto-detect location..." required="" rows="2"></textarea>
</div>
<div class="form-group">
<button class="btn-location" onclick="getLocation()" type="button">
<i data-lucide="map-pin"></i> Auto-Detect My Location
                </button>
<p id="location-status" style="font-size: 12px; color: var(--text-muted); margin-top: 8px; display: none;"></p>
<input id="lat_val" type="hidden"/><input id="lng_val" type="hidden"/>
</div>
<div class="form-section-title">Treatment Details</div>
<div class="form-group">
<label>Symptoms / Service Needed <span style="color:red">*</span></label>
<select class="form-control" id="pat_symptom" onchange="toggleCustomSymptom()" required="">
<option disabled="" selected="" value="">Select an issue or service...</option>
<option value="Intervertebral Disc Prolapse">Intervertebral Disc Prolapse</option>
<option value="Low Back Ache">Low Back Ache</option>
<option value="Cervical Spondylosis">Cervical Spondylosis</option>
<option value="Osteoarthritis of Knee">Osteoarthritis of Knee</option>
<option value="Periarthritis of Shoulder">Periarthritis of Shoulder</option>
<option value="Tennis Elbow">Tennis Elbow</option>
<option value="Plantar Fasciitis">Plantar Fasciitis</option>
<option value="Sports Injuries">Sports Injuries</option>
<option value="Stroke Rehabilitation">Stroke Rehabilitation</option>
<option value="Cerebral Palsy">Cerebral Palsy</option>
<option value="Bell's Palsy">Bell's Palsy</option>
<option value="Home Care Physiotherapy">Home Care Physiotherapy</option>
<option value="Other">Other (Type manually)</option>
</select>
<input class="form-control" id="pat_symptom_custom" placeholder="Please specify your issue" style="display: none; margin-top: 8px;" type="text"/>
</div>
<div class="form-group">
<label>Select Branch <span style="color:red">*</span></label>
<select class="form-control" id="pat_branch" required="">
<option disabled="" selected="" value="">Loading branches...</option>
</select>
</div>
<div class="form-row">
<div class="form-group">
<label>Preferred Date <span style="color:red">*</span></label>
<input class="form-control" id="pat_date" required="" type="date"/>
</div>
<div class="form-group">
<label>Preferred Time <span style="color:red">*</span></label>
<input class="form-control" id="pat_time" required="" type="time"/>
</div>
</div>
<div class="form-group">
<label>Brief Medical History / Notes (Optional)</label>
<textarea class="form-control" id="pat_notes" placeholder="Any previous injuries, surgeries, or specific pain areas..." rows="3"></textarea>
</div>
<button class="btn-primary" id="submitAppBtn" style="margin-top: 16px;" type="submit">
                Proceed to Submit <i data-lucide="check-circle"></i>
</button>
</form>
</div>
